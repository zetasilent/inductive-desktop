+BOARD_NETLIST_UPDATER::BOARD_NETLIST_UPDATER( TOOL_MANAGER* aToolManager, BOARD* aBoard ) :
+    m_frame( nullptr ),
+    m_commit( aToolManager ),
+    m_board( aBoard )
+{
+    m_reporter = &NULL_REPORTER::GetInstance();
+
+    m_deleteUnusedFootprints = false;
+    m_isDryRun = false;
+    m_replaceFootprints = true;
+    m_lookupByTimestamp = false;
+    m_transferGroups = false;
+    m_applyDesignBlockLayouts = false;
+    m_overrideLocks = false;
+    m_updateFields = false;
+    m_removeExtraFields = false;
+
+    m_warningCount = 0;
+    m_errorCount = 0;
+    m_newFootprintsCount = 0;
+}
+
+
+FOOTPRINT* BOARD_NETLIST_UPDATER::loadFootprint( const LIB_ID& aFootprintId )
+{
+    if( m_frame )
+        return m_frame->LoadFootprint( aFootprintId );
+
+    // As PCB_BASE_FRAME::loadFootprint does for the board editor.
+    FOOTPRINT* footprint = nullptr;
+
+    try
+    {
+        footprint = PROJECT_PCB::FootprintLibAdapter( m_board->GetProject() )
+                            ->LoadFootprintWithOptionalNickname( aFootprintId, false );
+    }
+    catch( const IO_ERROR& )
+    {
+    }
+
+    if( footprint )
+    {
+        footprint->ClearAllNets();
+
+        BOARD_DESIGN_SETTINGS& bds = m_board->GetDesignSettings();
+        footprint->ApplyDefaultSettings( *m_board, bds.m_StyleFPFields, bds.m_StyleFPText,
+                                         bds.m_StyleFPShapes, bds.m_StyleFPDimensions,
+                                         bds.m_StyleFPBarcodes );
+    }
+
+    return footprint;
+}
