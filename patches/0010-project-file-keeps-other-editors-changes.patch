@@ -768,7 +854,14 @@ bool PROJECT_FILE::SaveToFile( const wxString& aDirectory, bool aForce )
     // save should be cleared at this.
     m_wasMigrated = false;
 
-    return JSON_SETTINGS::SaveToFile( aDirectory, force );
+    // Flush first, so that what this process changed is known before another editor's
+    // sections are taken from disk; the base class then sees nothing new to flush, so tell it.
+    m_modified |= flushToStore();
+    adoptExternalChanges( aDirectory );
+
+    const bool saved = JSON_SETTINGS::SaveToFile( aDirectory, force || m_modified );
+    snapshotBaseline();
+    return saved;
 }
 
 
