+void PROJECT_FILE::snapshotBaseline()
+{
+    try
+    {
+        flushToStore();
+        m_baseline = formatFileContents();
+    }
+    catch( ... )
+    {
+        m_baseline.clear();
+    }
+}
+
+
+void PROJECT_FILE::adoptExternalChanges( const wxString& aDirectory )
+{
+    if( m_baseline.empty() || m_filename.IsEmpty() )
+        return;
+
+    wxFileName path;
+
+    if( aDirectory.empty() )
+        path.Assign( m_filename );
+    else
+        path.Assign( aDirectory, m_filename, getFileExt() );
+
+    path.SetExt( getFileExt() );
+
+    if( !path.FileExists() )
+        return;
+
+    nlohmann::json disk, base, mine;
+
+    try
+    {
+        std::ifstream in( path.GetFullPath().fn_str() );
+        disk = nlohmann::json::parse( in, nullptr, true, true );
+        base = nlohmann::json::parse( m_baseline );
+        mine = nlohmann::json::parse( formatFileContents() );
+    }
+    catch( ... )
+    {
+        return;
+    }
+
+    if( !disk.is_object() || !base.is_object() || !mine.is_object() )
+        return;
+
+    bool adopted = false;
+
+    for( auto it = disk.begin(); it != disk.end(); ++it )
+    {
+        const std::string& key = it.key();
+
+        if( key == "meta" )
+            continue;
+
+        const bool unchangedHere = base.contains( key ) ? mine.contains( key ) && mine[key] == base[key]
+                                                        : !mine.contains( key );
+        const bool changedThere = !base.contains( key ) || base[key] != it.value();
+
+        if( unchangedHere && changedThere )
+        {
+            ( *m_internals )[key] = it.value();
+            adopted = true;
+            wxLogTrace( traceSettings, wxT( "PROJECT_FILE: keeping section '%s' another editor saved" ),
+                        wxString::FromUTF8( key ) );
+        }
+    }
+
+    if( !adopted )
+        return;
+
+    // This process's own values were flushed above, so reloading every parameter picks up
+    // the adopted sections and leaves the rest as they were.
+    Load();
+
+    for( NESTED_SETTINGS* nested : m_nested_settings )
+        nested->LoadFromFile();
+}
