@@ -180,6 +212,26 @@ void STARTWIZARD::CheckAndRun( wxWindow* aParent )
     if( !wizardRequired )
         return;
 
+    // Inductive shows no KiCad setup wizard: its first-run step is its own sign-in.
+    // These are the defaults the wizard's Cancel applies -- fresh settings and the
+    // bundled libraries, no crash reports -- with KiCad's update and plugin-update
+    // checks off, since Inductive ships its own releases.
+    for( std::unique_ptr<STARTWIZARD_PROVIDER>& provider : m_providers )
+    {
+        if( provider->NeedsUserInput() )
+            provider->ApplyDefaults();
+    }
+
+    if( KICAD_SETTINGS* settings = Pgm().GetSettingsManager().GetAppSettings<KICAD_SETTINGS>( "kicad" ) )
+    {
+        settings->m_KiCadUpdateCheck = false;
+        settings->m_PcmUpdateCheck = false;
+        Pgm().GetSettingsManager().Save( settings );
+    }
+
+    relocateGlobalTables();
+    return;
+
     Pgm().HideSplash();
 
