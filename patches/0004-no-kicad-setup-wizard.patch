+// Inductive ships its libraries inside the app bundle. A global table that
+// names the bundle by absolute path breaks every library when the app is
+// moved, so refer to it through ${KICAD<major>_TEMPLATE_DIR}, which always
+// resolves to the running bundle's templates.
+static void relocateGlobalTables()
+{
+    for( LIBRARY_TABLE_TYPE type : { LIBRARY_TABLE_TYPE::SYMBOL, LIBRARY_TABLE_TYPE::FOOTPRINT,
+                                     LIBRARY_TABLE_TYPE::DESIGN_BLOCK } )
+    {
+        const wxString path = LIBRARY_MANAGER::DefaultGlobalTablePath( type );
+        wxString       text;
+        wxFFile        in( path, wxS( "r" ) );
+
+        if( !in.IsOpened() || !in.ReadAll( &text ) )
+            continue;
+
+        in.Close();
+
+        if( text.Replace( wxS( "\"" ) + LIBRARY_MANAGER::StockTablePath( type ) + wxS( "\"" ),
+                          wxS( "\"" ) + LIBRARY_MANAGER::StockTableTokenizedURI( type ) + wxS( "\"" ) ) )
+        {
+            wxFFile out( path, wxS( "w" ) );
+
+            if( out.IsOpened() )
+                out.Write( text );
+        }
+    }
+}
