diff --git a/eeschema/CMakeLists.txt b/eeschema/CMakeLists.txt
index 4d50026d..0577b07c 100644
--- a/eeschema/CMakeLists.txt
+++ b/eeschema/CMakeLists.txt
@@ -583,6 +583,11 @@ add_executable( eeschema WIN32 MACOSX_BUNDLE
     ${EESCHEMA_RESOURCES}
     )
 
+if( WIN32 )
+    # Inductive's own name, so an install never collides with KiCad's.
+    set_target_properties( eeschema PROPERTIES OUTPUT_NAME "inductive-schematic" )
+endif()
+
 set_source_files_properties( ${CMAKE_SOURCE_DIR}/common/single_top.cpp PROPERTIES
     COMPILE_DEFINITIONS "TOP_FRAME=FRAME_SCH;PGM_DATA_FILE_EXT=\"kicad_sch\";BUILD_KIWAY_DLL"
     )
diff --git a/kicad/CMakeLists.txt b/kicad/CMakeLists.txt
index b98c7965..a9deb714 100644
--- a/kicad/CMakeLists.txt
+++ b/kicad/CMakeLists.txt
@@ -127,6 +127,11 @@ add_executable( kicad-cli WIN32
     ${KICAD_RESOURCES}
     )
 
+if( WIN32 )
+    # Inductive's own name, so an install never collides with KiCad's.
+    set_target_properties( kicad PROPERTIES OUTPUT_NAME "inductive" )
+endif()
+
 if( MSVC )
    # The cli needs subsystem:console or else we can't link wmain/main
    set_target_properties(kicad-cli PROPERTIES COMPILE_DEFINITIONS_DEBUG "_CONSOLE")
