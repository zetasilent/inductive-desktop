          * @param aPath is the full path to insert
          */
         void AddDynamicLibrarySearchPath( const wxString& aPath );
+
+#ifdef __APPLE__
+        /**
+         * Wake the main event loop with an empty event. Call from wxApp::OSXOnDidFinishLaunching():
+         * wxWidgets stops [NSApp run] there, and AppKit only acts on the stop when the next event
+         * arrives. Launched with a document, the event wxWidgets queued for this is consumed
+         * before the stop, so OnInit() waited for the user's next mouse move or click -- seconds
+         * or minutes with no window.
+         */
+        void WakeEventLoop();
+#endif
     }
 }
 
