@@ -330,6 +330,16 @@ struct APP_SINGLE_TOP : public wxApp
         Pgm().MacOpenFile( aFileName );
     }
 
+    /**
+     * wxWidgets stops its launch loop here; without an event behind the stop, the loop
+     * waits for user input before OnInit() runs (see KIPLATFORM::APP::WakeEventLoop).
+     */
+    void OSXOnDidFinishLaunching() override
+    {
+        wxApp::OSXOnDidFinishLaunching();
+        KIPLATFORM::APP::WakeEventLoop();
+    }
+
 #endif
 };
 
